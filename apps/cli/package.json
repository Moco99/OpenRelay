{
  "name": "@velantex/openrelay",
  "version": "0.1.0",
  "description": "Multi-agent orchestration CLI for terminal AI agents",
  "type": "module",
  "bin": {
    "openrelay": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "cli",
    "claude",
    "gemini",
    "codex",
    "llm"
  ],
  "author": "Velantex",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.13"
  },
  "devDependencies": {
    "@openrelay/core": "workspace:*",
    "@openrelay/config": "workspace:*",
    "@openrelay/adapters": "workspace:*",
    "@openrelay/planner": "workspace:*",
    "@openrelay/tui": "workspace:*",
    "@types/react": "^19.2.14",
    "commander": "^13.1.0",
    "ink": "^7.0.1",
    "react": "^19.2.5",
    "typescript": "^5.8.3"
  }
}
